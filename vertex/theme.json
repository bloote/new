{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 2,
	"settings": {
		"appearanceTools": true,
		"layout": {
			"contentSize": "780px",
			"wideSize": "1200px"
		},
		"color": {
			"defaultPalette": false,
			"defaultGradients": false,
			"custom": true,
			"customGradient": true,
			"link": true,
			"palette": [
				{ "slug": "primary", "color": "#6d5ef7", "name": "Primary" },
				{ "slug": "primary-dark", "color": "#4a38e0", "name": "Primary Dark" },
				{ "slug": "accent", "color": "#18e0c8", "name": "Accent" },
				{ "slug": "coral", "color": "#ff6b6b", "name": "Coral" },
				{ "slug": "amber", "color": "#ffb020", "name": "Amber" },
				{ "slug": "ink", "color": "#0b0f1a", "name": "Ink" },
				{ "slug": "ink-2", "color": "#161d33", "name": "Ink Soft" },
				{ "slug": "base", "color": "#ffffff", "name": "White" },
				{ "slug": "surface", "color": "#f7f8fb", "name": "Surface" },
				{ "slug": "surface-2", "color": "#eef1f7", "name": "Surface 2" },
				{ "slug": "line", "color": "#dde3ee", "name": "Line" },
				{ "slug": "muted", "color": "#6b7690", "name": "Muted" },
				{ "slug": "text", "color": "#232a3d", "name": "Text" }
			],
			"gradients": [
				{ "slug": "brand", "gradient": "linear-gradient(120deg, #6d5ef7 0%, #8b7bff 40%, #18e0c8 100%)", "name": "Brand" },
				{ "slug": "brand-soft", "gradient": "linear-gradient(120deg, #ece9fe 0%, #e6fbf7 100%)", "name": "Brand Soft" },
				{ "slug": "ink", "gradient": "linear-gradient(160deg, #0b0f1a 0%, #161d33 60%, #1c2544 100%)", "name": "Ink" }
			]
		},
		"typography": {
			"fluid": true,
			"customFontSize": true,
			"lineHeight": true,
			"dropCap": false,
			"fontFamilies": [
				{ "slug": "body", "name": "Body (Inter)", "fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif" },
				{ "slug": "heading", "name": "Heading (Sora)", "fontFamily": "Sora, Inter, -apple-system, sans-serif" },
				{ "slug": "mono", "name": "Mono (JetBrains)", "fontFamily": "'JetBrains Mono', ui-monospace, Menlo, monospace" }
			],
			"fontSizes": [
				{ "slug": "small", "size": "0.9375rem", "name": "Small" },
				{ "slug": "medium", "size": "1.0625rem", "name": "Medium" },
				{ "slug": "large", "size": "1.25rem", "name": "Large" },
				{ "slug": "x-large", "size": "2rem", "name": "X Large" },
				{ "slug": "xx-large", "size": "clamp(2.25rem, 5vw, 3.75rem)", "name": "Huge" },
				{ "slug": "display", "size": "clamp(2.75rem, 7vw, 4.75rem)", "name": "Display" }
			]
		},
		"spacing": {
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"padding": true,
			"margin": true,
			"blockGap": true,
			"spacingSizes": [
				{ "slug": "20", "size": "1rem", "name": "1" },
				{ "slug": "30", "size": "1.5rem", "name": "2" },
				{ "slug": "40", "size": "2rem", "name": "3" },
				{ "slug": "50", "size": "3rem", "name": "4" },
				{ "slug": "60", "size": "4rem", "name": "5" },
				{ "slug": "70", "size": "6rem", "name": "6" }
			]
		},
		"border": { "color": true, "radius": true, "style": true, "width": true }
	},
	"styles": {
		"color": { "background": "var(--wp--preset--color--base)", "text": "var(--wp--preset--color--text)" },
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "1.0625rem",
			"lineHeight": "1.7"
		},
		"elements": {
			"heading": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "700", "lineHeight": "1.15", "letterSpacing": "-0.02em" },
				"color": { "text": "var(--wp--preset--color--ink)" }
			},
			"h1": { "typography": { "fontSize": "var(--wp--preset--font-size--display)" } },
			"h2": { "typography": { "fontSize": "var(--wp--preset--font-size--xx-large)" } },
			"link": {
				"color": { "text": "var(--wp--preset--color--primary-dark)" },
				"typography": { "textDecoration": "none" },
				":hover": { "typography": { "textDecoration": "none" } }
			},
			"button": {
				"border": { "radius": "999px" },
				"color": { "background": "var(--wp--preset--color--primary)", "text": "#ffffff" },
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)", "fontWeight": "600" },
				"spacing": { "padding": { "top": "0.9em", "bottom": "0.9em", "left": "1.6em", "right": "1.6em" } },
				":hover": { "color": { "background": "var(--wp--preset--color--primary-dark)" } }
			}
		},
		"blocks": {
			"core/quote": {
				"border": { "left": { "color": "var(--wp--preset--color--primary)", "width": "4px", "style": "solid" } },
				"spacing": { "padding": { "left": "2rem" } }
			},
			"core/pullquote": {
				"typography": { "fontFamily": "var(--wp--preset--font-family--heading)" }
			},
			"core/code": {
				"color": { "background": "var(--wp--preset--color--ink)", "text": "#e6e9f2" },
				"border": { "radius": "14px" },
				"spacing": { "padding": { "top": "1.5rem", "bottom": "1.5rem", "left": "1.5rem", "right": "1.5rem" } }
			}
		}
	},
	"templateParts": [],
	"customTemplates": []
}
