{
	"$schema": "https://schemas.wp.org/trunk/theme.json",
	"version": 3,
	"settings": {
		"appearanceTools": true,
		"useRootPaddingAwareAlignments": true,
		"layout": {
			"contentSize": "1200px",
			"wideSize": "1360px"
		},
		"background": {
			"backgroundImage": true,
			"backgroundSize": true
		},
		"border": {
			"color": true,
			"radius": true,
			"style": true,
			"width": true
		},
		"color": {
			"custom": true,
			"customDuotone": true,
			"defaultDuotone": false,
			"defaultGradients": false,
			"defaultPalette": false,
			"duotone": [
				{
					"name": "Blueprint",
					"slug": "blueprint",
					"colors": [ "#1d2d3d", "#eef6ff" ]
				},
				{
					"name": "Blueprint deep",
					"slug": "blueprint-deep",
					"colors": [ "#14202c", "#94bce3" ]
				},
				{
					"name": "Graphite",
					"slug": "graphite",
					"colors": [ "#1d1f20", "#f2f2f3" ]
				}
			],
			"palette": [
				{
					"name": "Base",
					"slug": "base",
					"color": "#f2f2f3"
				},
				{
					"name": "Surface",
					"slug": "surface",
					"color": "#e9e9ea"
				},
				{
					"name": "Ink",
					"slug": "ink",
					"color": "#1d1f20"
				},
				{
					"name": "Accent",
					"slug": "accent",
					"color": "#5980a6"
				},
				{
					"name": "Accent tint",
					"slug": "accent-tint",
					"color": "#eef6ff"
				},
				{
					"name": "Accent light",
					"slug": "accent-light",
					"color": "#b5d9fd"
				},
				{
					"name": "Accent deep",
					"slug": "accent-deep",
					"color": "#416180"
				},
				{
					"name": "Accent dark",
					"slug": "accent-dark",
					"color": "#1d2d3d"
				},
				{
					"name": "Muted",
					"slug": "muted",
					"color": "#7a7a7d"
				},
				{
					"name": "Divider",
					"slug": "divider",
					"color": "#d4d4d7"
				}
			]
		},
		"custom": {
			"divider": "color-mix(in srgb, #1d1f20 16%, transparent)",
			"quiet": "color-mix(in srgb, currentColor 62%, transparent)",
			"grid": "68px",
			"sectionPadding": "clamp(3.5rem, 7vw, 6rem)",
			"railWidth": "200px"
		},
		"dimensions": {
			"aspectRatio": true,
			"minHeight": true
		},
		"position": {
			"sticky": true
		},
		"shadow": {
			"defaultPresets": false,
			"presets": [
				{
					"name": "Small",
					"slug": "small",
					"shadow": "0 1px 2px color-mix(in srgb, #2b2b2d 14%, transparent)"
				},
				{
					"name": "Medium",
					"slug": "medium",
					"shadow": "0 3px 10px color-mix(in srgb, #2b2b2d 16%, transparent)"
				},
				{
					"name": "Large",
					"slug": "large",
					"shadow": "0 12px 32px color-mix(in srgb, #2b2b2d 22%, transparent)"
				}
			]
		},
		"spacing": {
			"customSpacingSize": true,
			"defaultSpacingSizes": false,
			"units": [ "px", "em", "rem", "vh", "vw", "%" ],
			"spacingSizes": [
				{
					"name": "1 — Hairline",
					"slug": "10",
					"size": "0.25rem"
				},
				{
					"name": "2 — Tight",
					"slug": "20",
					"size": "0.5rem"
				},
				{
					"name": "3 — Snug",
					"slug": "30",
					"size": "0.75rem"
				},
				{
					"name": "4 — Base",
					"slug": "40",
					"size": "1.25rem"
				},
				{
					"name": "5 — Roomy",
					"slug": "50",
					"size": "1.75rem"
				},
				{
					"name": "6 — Gutter",
					"slug": "60",
					"size": "2.25rem"
				},
				{
					"name": "7 — Block",
					"slug": "70",
					"size": "3rem"
				},
				{
					"name": "8 — Section",
					"slug": "80",
					"size": "clamp(3.5rem, 7vw, 6rem)"
				},
				{
					"name": "9 — Chapter",
					"slug": "90",
					"size": "clamp(4.5rem, 9vw, 7.5rem)"
				}
			]
		},
		"typography": {
			"customFontSize": true,
			"defaultFontSizes": false,
			"dropCap": false,
			"fluid": true,
			"letterSpacing": true,
			"lineHeight": true,
			"textTransform": true,
			"writingMode": true,
			"fontFamilies": [
				{
