				{
					"name": "Monospace",
					"slug": "mono",
					"fontFamily": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
				}
			],
			"fontSizes": [
				{
					"name": "Tiny",
					"slug": "tiny",
					"size": "0.6875rem",
					"fluid": false
				},
				{
					"name": "Small",
					"slug": "small",
					"size": "0.8125rem",
					"fluid": false
				},
				{
					"name": "Medium",
					"slug": "medium",
					"size": "0.9375rem",
					"fluid": false
				},
				{
					"name": "Large",
					"slug": "large",
					"size": "1.0625rem",
					"fluid": false
				},
				{
					"name": "X Large",
					"slug": "x-large",
					"size": "1.1875rem",
					"fluid": false
				},
				{
					"name": "Heading 4",
					"slug": "heading-4",
					"size": "1.375rem",
					"fluid": {
						"min": "1.25rem",
						"max": "1.4375rem"
					}
				},
				{
					"name": "Heading 3",
					"slug": "heading-3",
					"size": "1.625rem",
					"fluid": {
						"min": "1.375rem",
						"max": "1.75rem"
					}
				},
				{
					"name": "Heading 2",
					"slug": "heading-2",
					"size": "2.375rem",
					"fluid": {
						"min": "1.75rem",
						"max": "2.75rem"
					}
				},
				{
					"name": "Display",
					"slug": "display",
					"size": "3.25rem",
					"fluid": {
						"min": "2.25rem",
						"max": "4.125rem"
					}
				},
				{
					"name": "Display XL",
					"slug": "display-xl",
					"size": "4rem",
					"fluid": {
						"min": "2.75rem",
						"max": "4.625rem"
					}
				}
			]
		}
	},
	"styles": {
		"color": {
			"background": "var(--wp--preset--color--base)",
			"text": "var(--wp--preset--color--ink)"
		},
		"typography": {
			"fontFamily": "var(--wp--preset--font-family--body)",
			"fontSize": "var(--wp--preset--font-size--medium)",
			"fontWeight": "400",
			"lineHeight": "1.55"
		},
		"spacing": {
			"blockGap": "var(--wp--preset--spacing--40)",
			"padding": {
				"left": "clamp(1.25rem, 5vw, 2.5rem)",
				"right": "clamp(1.25rem, 5vw, 2.5rem)"
			}
		},
		"elements": {
			"heading": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontWeight": "600",
					"lineHeight": "1.12",
					"letterSpacing": "-0.015em"
				}
			},
			"h1": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--display)",
					"lineHeight": "1",
					"letterSpacing": "-0.025em"
				}
			},
			"h2": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-2)"
				}
			},
			"h3": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-3)"
				}
			},
			"h4": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--heading-4)"
				}
			},
			"h5": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--large)"
				}
			},
			"h6": {
				"typography": {
					"fontSize": "var(--wp--preset--font-size--small)",
					"textTransform": "uppercase",
					"letterSpacing": "0.08em"
				}
			},
			"link": {
				"color": {
					"text": "var(--wp--preset--color--accent-deep)"
				},
				"typography": {
					"textDecoration": "underline"
				},
				":hover": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				},
				":focus": {
					"color": {
						"text": "var(--wp--preset--color--accent)"
					}
				}
			},
			"button": {
				"border": {
					"radius": "0",
					"width": "1px",
					"style": "solid",
					"color": "var(--wp--preset--color--accent)"
				},
				"color": {
					"background": "var(--wp--preset--color--accent)",
					"text": "var(--wp--preset--color--base)"
				},
				"spacing": {
					"padding": {
						"top": "0.8rem",
						"bottom": "0.8rem",
						"left": "1.6rem",
						"right": "1.6rem"
					}
				},
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "0.875rem",
					"fontWeight": "600",
					"letterSpacing": "0.08em",
					"lineHeight": "1.2",
					"textTransform": "uppercase",
					"textDecoration": "none"
				},
				":hover": {
					"color": {
						"background": "var(--wp--preset--color--accent-deep)",
						"text": "var(--wp--preset--color--base)"
					},
					"border": {
						"color": "var(--wp--preset--color--accent-deep)"
					}
				},
				":focus": {
					"color": {
						"background": "var(--wp--preset--color--accent-deep)",
						"text": "var(--wp--preset--color--base)"
					}
				},
				":active": {
					"color": {
						"background": "var(--wp--preset--color--accent-dark)",
						"text": "var(--wp--preset--color--base)"
					}
				}
			},
			"caption": {
				"color": {
					"text": "var(--wp--preset--color--muted)"
				},
				"typography": {
					"fontSize": "var(--wp--preset--font-size--tiny)"
				}
			}
		},
		"blocks": {
			"core/site-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "1.1875rem",
					"fontWeight": "600",
					"letterSpacing": "0.06em",
					"textTransform": "uppercase"
				},
				"elements": {
					"link": {
						"color": {
							"text": "var(--wp--preset--color--ink)"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--accent)"
							}
						}
					}
				}
			},
			"core/post-title": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"letterSpacing": "-0.025em",
					"lineHeight": "1.04"
				},
				"elements": {
					"link": {
						"color": {
							"text": "currentColor"
						},
						"typography": {
							"textDecoration": "none"
						},
						":hover": {
							"color": {
								"text": "var(--wp--preset--color--accent-deep)"
							}
						}
					}
				}
			},
			"core/post-terms": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				}
			},
			"core/post-date": {
				"typography": {
					"fontFamily": "var(--wp--preset--font-family--heading)",
					"fontSize": "var(--wp--preset--font-size--small)",
					"letterSpacing": "0.14em",
					"textTransform": "uppercase"
				},
				"color": {
					"text": "var(--wp--preset--color--muted)"
				}
			},
